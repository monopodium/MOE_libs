+// EPA arena: take want[d] pages of destination d's arena (one reservation per
+// destination) and store their ids, from page first[d] on, in this rank's local page
+// table and in d's table of this source; got[d] = want[d], or 0 if d's arena was short.
+// Run by a team of n threads (tid) with barrier `sync`; page ids are read in parallel.
+template <typename team_t, int kNumRanks, typename gin_t, typename sync_t>
+__device__ __forceinline__ void epa_arena_take(const layout::EPALayout& epa, void* buffer, const gin_t& gin,
+                                               const int rank_idx, const int* want, const int* first, int* got,
+                                               long long* tickets, int* pfx, const int tid, const int n,
+                                               const sync_t& sync) {
+    const auto a = epa.arena(buffer);
+    for (int d = tid; d < kNumRanks; d += n) {
+        epa::Arena da = a;
+        da.base = gin.template get_sym_ptr<team_t>(a.base, d);
+        tickets[d] = want[d] > 0 ? da.try_take(want[d]) : -1;
+    }
+    sync();
+    if (tid == 0) {
+        int acc = 0;
+        for (int d = 0; d < kNumRanks; ++ d)
+            pfx[d] = acc, acc += tickets[d] >= 0 ? want[d] : 0;
+        pfx[kNumRanks] = acc;
+    }
+    sync();
+    for (int q = tid; q < pfx[kNumRanks]; q += n) {
+        int d = 0;
+        while (q >= pfx[d + 1]) ++ d;
+        epa::Arena da = a;
+        da.base = gin.template get_sym_ptr<team_t>(a.base, d);
+        const int p = first[d] + q - pfx[d];
+        const int id = da.page_at(static_cast<unsigned long long>(tickets[d]), q - pfx[d]);
+        epa.ltable(buffer)[d * epa.max_pages + p] = id;
+        *gin.template get_sym_ptr<team_t>(epa.rtable(buffer) + rank_idx * epa.max_pages + p, d) = id;
+    }
+    sync();
+    for (int d = tid; d < kNumRanks; d += n)
+        got[d] = tickets[d] >= 0 ? want[d] : 0;
+    sync();
+}
